<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://preparatAcceptDetailView.title"
      focusComponent="form">
    <data>
        <instance id="preparatAcceptDc"
                  class="com.company.onboarding.entity.PreparatAccept">
            <fetchPlan extends="_base"/>
            <loader id="preparatAcceptDl"/>
        </instance>
        <collection id="preparatsDc" class="com.company.onboarding.entity.Preparat">
            <loader id="preparatsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Preparat e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>

    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="preparatAcceptDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <dateTimePicker id="acceptedDateField" property="acceptedDate"/>
            <entityComboBox id="entityComboBox" property="preparat" itemsContainer="preparatsDc"/>
            <!--<entityPicker id="preparatField" property="preparat">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>-->
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
