<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://preparatAcceptListView.title"
      focusComponent="preparatAcceptsDataGrid">
    <data>
        <collection id="preparatAcceptsDc"
                    class="com.company.onboarding.entity.PreparatAccept">
            <fetchPlan extends="_base"/>
            <loader id="preparatAcceptsDl" readOnly="true">
                <query>
                    <![CDATA[select e from PreparatAccept e where e.user = :user1]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="false"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="preparatAcceptsDl" opened="false">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="preparatAcceptsDataGrid.createAction"/>
                <button id="editButton" action="preparatAcceptsDataGrid.editAction"/>
                <button id="removeButton" action="preparatAcceptsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="preparatAcceptsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="preparatAcceptsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="preparatAcceptsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="acceptedDate"/>
                <column property="preparat"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
